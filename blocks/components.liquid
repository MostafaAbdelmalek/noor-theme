<div class="mp-components-wrapper mp-components-{{ block.id }}" {{ block.shopify_attributes }}>
  <style>
    /* Wrapper layout */
    .mp-components-{{ block.id }}{
      background: {{ block.settings.background_color | default: '#ffffff' }};
      border: {{ block.settings.border_width | default: 0 }}px solid {{ block.settings.border_color | default: '#e6e6e6' }};
      border-radius: {{ block.settings.border_radius | default: 0 }}px;
      padding: {{ block.settings.padding | default: 16 }}px;
      box-sizing: border-box;
    }

    /* Title */
    .mp-components-{{ block.id }} .mp-components-title{
      margin: 0 0 12px 0;
      color: {{ block.settings.title_color | default: '#222222' }};
      font-size: {{ block.settings.title_size | default: 20 }}px;
      font-weight: {{ block.settings.title_weight | default: 600 }};
      text-align: {{ block.settings.title_alignment | default: 'right' }};
    }

    /* Grid */
    .mp-components-{{ block.id }} .mp-components-grid{
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: {{ block.settings.gap | default: 16 }}px;
      align-items: start;
      justify-content: center;
    }

    /* Component item */
    .mp-components-{{ block.id }} .mp-component-item{
      text-align: {{ block.settings.item_text_alignment | default: 'center' }};
      color: {{ block.settings.item_text_color | default: '#222222' }};
      font-size: clamp(12px, calc({{ block.settings.item_text_size | default: 14 }}px * 0.8), {{ block.settings.item_text_size | default: 14 }}px);
      font-weight: {{ block.settings.item_text_weight | default: 400 }};
      display: flex;
      flex-direction: column;
      gap: 8px;
      align-items: center;
      width: 100%;
    }

    .mp-components-{{ block.id }} .mp-component-image{
      width: clamp(40px, 100%, {{ block.settings.image_size | default: 80 }}px);
      height: clamp(40px, 100%, {{ block.settings.image_size | default: 80 }}px);
      border-radius: {{ block.settings.image_radius | default: 50 }}%;
      overflow: hidden;
      display: block;
      aspect-ratio: 1;
    }

    .mp-components-{{ block.id }} .mp-component-image img{
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    /* Responsive adjustments */
    @media screen and (max-width: 767px){
      .mp-components-{{ block.id }}{
        padding: calc({{ block.settings.padding | default: 16 }}px * 0.75);
      }
      .mp-components-{{ block.id }} .mp-components-grid{
        gap: calc({{ block.settings.gap | default: 16 }}px * 0.75);
      }
      .mp-components-{{ block.id }} .mp-components-title{
        font-size: clamp(16px, calc({{ block.settings.title_size | default: 20 }}px * 0.9), {{ block.settings.title_size | default: 20 }}px);
      }
    }
  </style>

  {% if block.settings.title != blank %}
    <h3 class="mp-components-title">{{ block.settings.title }}</h3>
  {% endif %}

  <div class="mp-components-grid">
    {% for i in (1..18) %}
      {% liquid
        assign enabled_key = 'item_' | append: i | append: '_enabled'
        assign image_key = 'item_' | append: i | append: '_image'
        assign text_key = 'item_' | append: i | append: '_text'

        assign enabled = block.settings[enabled_key]
        assign image = block.settings[image_key]
        assign text = block.settings[text_key]
      %}

      {% if enabled %}
        <div class="mp-component-item">
          <span class="mp-component-image">
            {% if image != blank %}
              <img src="{{ image | image_url: width: block.settings.image_size | default: 80 }}" alt="{{ text | escape }}" loading="lazy" />
            {% else %}
              {{ 'image' | placeholder_svg_tag }}
            {% endif %}
          </span>

          {% if text != blank %}
            <div class="mp-component-text">{{ text }}</div>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>


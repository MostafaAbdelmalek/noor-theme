        "custom_liquid": "<script>\n/*(function () {\n  function checkCartAndShow() {\n    fetch('/cart.js')\n      .then(r => r.json())\n      .then(cart => {\n        if (cart.items.length > 0) {\n          let lastShown = localStorage.getItem(\"popupShownAt\");\n          let now = new Date();\n          let oneWeek = 3.5 * 24 * 60 * 60 * 1000;\n\n          if (!lastShown || (now - new Date(lastShown)) > oneWeek) {\n            showPopup();\n            localStorage.setItem(\"popupShownAt\", now.toISOString());\n          }\n        }\n      });\n  }\n\n  function showPopup() {\n    let popup = document.createElement(\"div\");\n    popup.innerHTML = `\n      <div id=\"custom-popup-overlay\" style=\"\n        position: fixed;\n        top: 0; left: 0; width: 100%; height: 100%;\n        background: rgba(0,0,0,0.6);\n        display: flex; justify-content: center; align-items: center;\n        z-index: 9999;\">\n        <div id=\"custom-popup-box\" style=\"\n          position: relative;\n          background:#fff; border-radius:8px;\n          max-width:400px; overflow:hidden;\">\n          <img src=\"https://i.ibb.co/kj4DJKc/pop.webp\" \n               alt=\"عرض خاص\" style=\"display:block; width:100%; height:auto;\">\n          <button id=\"close-popup\" style=\"\n            position:absolute; top:10px; right:10px;\n            background:transparent; border:none;\n            font-size:35px; cursor:pointer; line-height:1;\">&times;</button>\n        </div>\n      </div>`;\n    document.body.appendChild(popup);\n\n    // زر الإغلاق\n    document.getElementById(\"close-popup\").addEventListener(\"click\", () => {\n      document.getElementById(\"custom-popup-overlay\").remove();\n    });\n\n    // الضغط على الخلفية يقفل البوب أب\n    document.getElementById(\"custom-popup-overlay\").addEventListener(\"click\", (e) => {\n      if (e.target.id === \"custom-popup-overlay\") {\n        document.getElementById(\"custom-popup-overlay\").remove();\n      }\n    });\n  }\n\n  checkCartAndShow();\n\n  const oldFetch = window.fetch;\n  window.fetch = function() {\n    return oldFetch.apply(this, arguments).then(res => {\n      try {\n        if (arguments[0].includes('/cart/add')) {\n          checkCartAndShow();\n        }\n      } catch(e){}\n      return res;\n    });\n  };\n\n})();\n*/\n</script>",

      "name": "t:sections.custom-liquid.name",
      "settings": {
        "custom_liquid": "<style>\n.jdgm-rev-widg .jdgm-star, .jdgm-revs-tab .jdgm-star, .jdgm-all-reviews .jdgm-star, .jdgm-gallery-popup .jdgm-star {\n    color: #f28535 !important;\n}\n.hdt-ratio--contain .hdt-ratio>img, .hdt-object-contain {\n    border-radius: 15px;\n    object-fit: cover;\n}\nhtml, body {\n    overflow-x: hidden;\n}\ndiv#shopify-section-template--18890923704511__custom_section_X4HNfD{\n    background: linear-gradient(180deg, #267948 0%, #529a4a 100%);\n}\ndiv#shopify-section-template--18890923704511__custom_section_qMLTB9 {\n    background: #529A4A;\n}\n#product-form-template--18890923704511__main-product8208861790399 .hdt-product-form__buttons .hdt-product-form__submit {\n    background: #2f854e;\n    border-color: #2f854e;\n}\n#product-form-template--18890923704511__main-product8208861790399 > hdt-buy-buttons > div.shopify-payment-button > shopify-accelerated-checkout > shopify-buy-it-now-button > button {\n    background: #17a78b !important;\n}\n.hdt-product-info__item.hdt-product__buy-button {\n  position: fixed;\n  bottom: 0;\n  left: 0;\n  background: #fff;\n  margin: 0;\n  padding: 10px 5px;\n}\n.hdt-product-info__item.hdt-product__buy-button:nth-child(7) {\n    position: relative;\n    padding: 15px;\n    border: 1px solid var(--Semantic-Border-Gray, #E9ECEA);\n}\n#product-info-template--18890923704511__main-product > div.hdt-product-info__item.hdt-product__extra-link a {\n    display: flex\n;\n    flex-direction: row;\n    flex-wrap: nowrap;\n    align-items: center;\n    opacity: 1;\n    padding-top: 8px;\n    padding-right: 12px;\n    padding-bottom: 8px;\n    padding-left: 12px;\n    border-radius: 8px;\n    background: var(--Semantic-Bg-Grey-Light, #F7F8F7);\n    width: 95%;\n    justify-content: space-between;\n}\n#product-info-template--18890923704511__main-product > div.hdt-product-info__item.hdt-product__extra-link a:after {\n    content: \"\";\n    height: 12px;\n    background: url(https://cdn.shopify.com/s/files/1/0675/4176